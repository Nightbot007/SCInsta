{#- =========================================================================
  AB HIER: LOGIK
========================================================================= -#}

{%- from 'lichtstimmung_buch.jinja' import BUCH -%}
{%- set FARBMODI = ['hs', 'rgb', 'rgbw', 'rgbww', 'xy'] -%}
{%- set FAVORIT = '★ ' -%}

{#- Alle Lampen-IDs (JSON-Liste) -#}
{%- macro lampen_ids() -%}
{{- LAMPEN | map(attribute='id') | list | to_json -}}
{%- endmacro -%}

{#- Lampen, die gerade an sind (JSON-Liste) -#}
{%- macro lampen_an() -%}
{%- set ns = namespace(l=[]) -%}
{%- for l in LAMPEN if is_state(l.id, 'on') -%}
  {%- set ns.l = ns.l + [l.id] -%}
{%- endfor -%}
{{- ns.l | to_json -}}
{%- endmacro -%}

{#- Eingeschaltete Lampen, die bei Gewitter aufblitzen dürfen (JSON-Liste) -#}
{%- macro blitz_kandidaten() -%}
{%- set ns = namespace(l=[]) -%}
{%- for l in LAMPEN if l.get('blitz', true) and is_state(l.id, 'on') -%}
  {%- set ns.l = ns.l + [l.id] -%}
{%- endfor -%}
{{- ns.l | to_json -}}
{%- endmacro -%}

{#- Lampen, deren Befehle wiederholt werden (JSON-Liste) -#}
{%- macro nachsende_lampen() -%}
{{- LAMPEN | selectattr('nachsenden', 'defined') | selectattr('nachsenden') | map(attribute='id') | list | to_json -}}
{%- endmacro -%}

{#- Werden Befehle an diese Lampe wiederholt? (JSON: true/false) -#}
{%- macro nachsenden(lampe) -%}
{{- (lampe in (nachsende_lampen() | from_json)) | to_json -}}
{%- endmacro -%}

{#- Pause vor dem Wiederholen in Sekunden -#}
{%- macro nachsende_pause() -%}
{{- NACHSENDEN_PAUSE -}}
{%- endmacro -%}

{#- Namen aller aktiven Modi in der festgelegten Reihenfolge (JSON-Liste) -#}
{%- macro modi_namen() -%}
{%- set ns = namespace(l=[]) -%}
{%- for name, m in MODI.items() if m.get('aktiv', true) -%}
  {%- set ns.l = ns.l + [name] -%}
{%- endfor -%}
{{- ns.l | to_json -}}
{%- endmacro -%}

{#- Gespeicherter Favorit zu „★ Name“ (Dict) oder {} -#}
{%- macro _favorit(modus) -%}
{%- set alle = state_attr('sensor.lichtstimmung_favoriten', 'favoriten') -%}
{%- set name = modus[FAVORIT | length:] if modus is string and modus.startswith(FAVORIT) else none -%}
{{- ((alle.get(name) if alle is mapping and name else none) or {}) | to_json -}}
{%- endmacro -%}

{#- Grundmodus: bei Favoriten der Modus, aus dem sie gespeichert wurden -#}
{%- macro basis(modus) -%}
{%- if modus is string and modus.startswith(FAVORIT) -%}
  {{- (_favorit(modus) | from_json).get('basis', '') -}}
{%- else -%}
  {{- modus -}}
{%- endif -%}
{%- endmacro -%}

{#- Effekt des (Grund-)Modus, z. B. 'blitze', sonst leer -#}
{%- macro effekt(modus) -%}
{{- MODI.get(basis(modus), {}).get('effekt', '') -}}
{%- endmacro -%}

{#- Überblendzeit in Sekunden -#}
{%- macro uebergang(modus) -%}
{{- MODI.get(basis(modus), {}).get('uebergang', 1.5) -}}
{%- endmacro -%}

{#- Alle Kombinationen, aus denen ein Modus wählen kann: [[Name, Palette], …] -#}
{%- macro _topf(m, nur_eigene) -%}
{%- set ns = namespace(l=[]) -%}
{%- if nur_eigene -%}
  {%- for p in m.get('eigene', []) -%}
    {%- set ns.l = ns.l + [['Eigene Palette ' ~ loop.index, p]] -%}
  {%- endfor -%}
{%- else -%}
  {%- set nummern = BUCH.keys() | list if m.get('buch') == 'alle' else m.get('buch', []) -%}
  {%- for nr in nummern if nr in BUCH -%}
    {%- set ns.l = ns.l + [['Buch Nr. ' ~ nr, BUCH[nr]]] -%}
  {%- endfor -%}
{%- endif -%}
{{- ns.l | to_json -}}
{%- endmacro -%}

{#- -------------------------------------------------------------------------
  Farbzuweisung für einen Modus (JSON: {'lampen': {Lampe: Wert}, 'quelle': …})
  Wert: {'an': false}
        {'an': true, 'hs': [Farbton, Sättigung], 'hell': %}   Farblampen
        {'an': true, 'kelvin': K, 'hell': %}                  Weiß-Lampen
        {'an': true, 'hell': %}                               nur Helligkeit
  Wählt eine Kombination (nie zweimal hintereinander dieselbe), dreht sie
  zufällig weiter, wählt die Laufrichtung und streut den Farbton leicht –
  Nachbarn bleiben harmonisch.
------------------------------------------------------------------------- -#}
{%- macro zuweisung(modus) -%}
{%- set ns = namespace(out={}, quelle='') -%}
{%- if modus is string and modus.startswith(FAVORIT) -%}
  {%- set fav = _favorit(modus) | from_json -%}
  {%- set werte = fav.get('lampen', {}) -%}
  {%- for l in LAMPEN if l.id in werte -%}
    {%- set ns.out = dict(ns.out, **{l.id: werte[l.id]}) -%}
  {%- endfor -%}
  {%- set ns.quelle = fav.get('quelle', '') -%}
{%- elif modus in MODI -%}
  {%- set m = MODI[modus] -%}
  {%- set letzte = state_attr('sensor.lichtstimmung_zustand', 'quelle')
        if is_state('sensor.lichtstimmung_zustand', modus) else none -%}
  {%- set alle_buch = _topf(m, false) | from_json -%}
  {%- set alle_eigene = _topf(m, true) | from_json -%}
  {#- die zuletzt gezeigte Kombination nicht gleich noch einmal -#}
  {%- set buch = alle_buch | rejectattr('0', 'eq', letzte) | list -%}
  {%- set eigene = alle_eigene | rejectattr('0', 'eq', letzte) | list -%}
  {%- set nimm_eigene = eigene | count > 0
        and (buch | count == 0 or (range(100) | random) < m.get('eigene_anteil', 30)) -%}
  {%- set topf = eigene if nimm_eigene else buch -%}
  {%- set topf = topf if topf | count > 0 else alle_eigene + alle_buch -%}
  {%- if topf | count > 0 -%}
    {%- set wahl = topf | random -%}
    {%- set ns.quelle = wahl[0] -%}
    {%- set versatz = range(100) | random -%}
    {%- set richtung = [1, -1] | random -%}
    {%- set s = m.get('streuung', 5) | int -%}
    {%- for l in LAMPEN -%}
      {%- set palette = m.get('typ_farben', {}).get(l.typ, wahl[1]) -%}
      {%- set f = palette[(versatz + richtung * loop.index0) % (palette | count)] -%}
      {%- set grund = m.hell.get(l.typ, m.hell.get('standard', 50)) | int -%}
      {%- set hell = [(grund * (f[2] if f | count > 2 else 1)) | round(0) | int, 1] | max if grund > 0 else 0 -%}
      {%- set modi = state_attr(l.id, 'supported_color_modes') or [] -%}
      {%- if hell <= 0 -%}
        {%- set w = {'an': false} -%}
      {%- elif modi | select('in', FARBMODI) | list | count > 0 -%}
        {%- set farbton = (f[0] + (range(-s, s + 1) | random)) % 360 -%}
        {%- set saettigung = [[f[1] + (range(-4, 5) | random), 0] | max, 100] | min -%}
        {%- set w = {'an': true, 'hs': [farbton, saettigung], 'hell': hell} -%}
      {%- elif 'color_temp' in modi -%}
        {%- set w = {'an': true, 'kelvin': m.get('kelvin', 2700), 'hell': hell} -%}
      {%- else -%}
        {%- set w = {'an': true, 'hell': hell} -%}
      {%- endif -%}
      {%- set ns.out = dict(ns.out, **{l.id: w}) -%}
    {%- endfor -%}
  {%- endif -%}
{%- endif -%}
{{- {'lampen': ns.out, 'quelle': ns.quelle} | to_json -}}
{%- endmacro -%}

{#- Aktueller Zustand aller Lampen wie zuweisung(), aber exakt: Farbe als 'xy'/'rgb'/'hs'
    (je nach Lampe), Helligkeit als 'bri' (1–255) -#}
{%- macro momentaufnahme() -%}
{%- set ns = namespace(out={}) -%}
{%- for l in LAMPEN -%}
  {%- if is_state(l.id, 'on') -%}
    {%- set bri = [state_attr(l.id, 'brightness') | int(255), 1] | max -%}
    {%- set cm = state_attr(l.id, 'color_mode') -%}
    {%- set hs = state_attr(l.id, 'hs_color') -%}
    {%- set xy = state_attr(l.id, 'xy_color') -%}
    {%- set rgb = state_attr(l.id, 'rgb_color') -%}
    {%- set k = state_attr(l.id, 'color_temp_kelvin') -%}
    {#- im eigenen Farbformat der Lampe speichern – so kommt die Farbe exakt zurück -#}
    {%- if cm == 'xy' and xy -%}
      {%- set w = {'an': true, 'xy': [xy[0], xy[1]], 'bri': bri} -%}
    {%- elif cm == 'rgb' and rgb -%}
      {%- set w = {'an': true, 'rgb': [rgb[0], rgb[1], rgb[2]], 'bri': bri} -%}
    {%- elif cm in FARBMODI and hs -%}
      {%- set w = {'an': true, 'hs': [hs[0] | round(1), hs[1] | round(1)], 'bri': bri} -%}
    {%- elif cm == 'color_temp' and k -%}
      {%- set w = {'an': true, 'kelvin': k | int, 'bri': bri} -%}
    {%- else -%}
      {%- set w = {'an': true, 'bri': bri} -%}
    {%- endif -%}
  {%- else -%}
    {%- set w = {'an': false} -%}
  {%- endif -%}
  {%- set ns.out = dict(ns.out, **{l.id: w}) -%}
{%- endfor -%}
{{- ns.out | to_json -}}
{%- endmacro -%}

{#- An/aus und Helligkeit (1–255) aller Lampen, für „Volle Helligkeit“ -#}
{%- macro helligkeit_aufnahme() -%}
{%- set ns = namespace(out={}) -%}
{%- for l in LAMPEN -%}
  {%- if is_state(l.id, 'on') -%}
    {%- set w = {'an': true, 'bri': [state_attr(l.id, 'brightness') | int(255), 1] | max} -%}
  {%- else -%}
    {%- set w = {'an': false} -%}
  {%- endif -%}
  {%- set ns.out = dict(ns.out, **{l.id: w}) -%}
{%- endfor -%}
{{- ns.out | to_json -}}
{%- endmacro -%}

{#- Favoritenliste nach Speichern/Löschen (für sensor.lichtstimmung_favoriten) -#}
{%- macro favoriten_neu(alt, d) -%}
{%- set alt = alt if alt is mapping else {} -%}
{%- set name = (d.get('name') or '') | string | trim -%}
{%- if d.get('aktion') == 'speichern' and name -%}
  {%- set eintrag = {'basis': d.get('basis', ''), 'quelle': d.get('quelle', ''), 'lampen': d.get('lampen', {})} -%}
  {{- dict(alt, **{name: eintrag}) | to_json -}}
{%- elif d.get('aktion') == 'loeschen' -%}
  {%- set ns = namespace(out={}) -%}
  {%- for k, v in alt.items() if k != name -%}
    {%- set ns.out = dict(ns.out, **{k: v}) -%}
  {%- endfor -%}
  {{- ns.out | to_json -}}
{%- else -%}
  {{- alt | to_json -}}
{%- endif -%}
{%- endmacro -%}

{#- -------------------------------------------------------------------------
  Konfigurations-Check – in Entwicklerwerkzeuge → Template einfügen:
    {% from 'lichtstimmung.jinja' import pruefen %}{{ pruefen() }}
------------------------------------------------------------------------- -#}
{%- macro pruefen() -%}
LAMPEN ({{ LAMPEN | count }})
{%- for l in LAMPEN %}
{%- set modi = state_attr(l.id, 'supported_color_modes') or [] %}
- {{ l.id }} [{{ l.typ }}{{ ', blitzt' if l.get('blitz', true) else '' }}{{ ', sendet nach' if l.get('nachsenden') else '' }}]:
{%- if expand(l.id) | count == 0 %} ❌ nicht gefunden – Entity-ID prüfen
{%- else %} {{ states(l.id) }} · {{ 'Farbe' if modi | select('in', FARBMODI) | list | count > 0 else ('nur Weiß (Kelvin)' if 'color_temp' in modi else 'nur Helligkeit') }}
{%- endif %}
{%- endfor %}

MODI (Farbwörterbuch: {{ BUCH | count }} Kombinationen als Licht geeignet)
{%- for name, m in MODI.items() %}
{%- set typen = LAMPEN | map(attribute='typ') | unique | list %}
{%- set ohne_hell = typen | reject('in', m.get('hell', {}).keys() | list) | list %}
{%- set buch = _topf(m, false) | from_json %}
{%- set eigene = m.get('eigene', []) %}
{%- set fehlt = [] if m.get('buch') == 'alle' else m.get('buch', []) | reject('in', BUCH) | list %}
- {{ name }}{{ '' if m.get('aktiv', true) else ' (inaktiv)' }}: {{ buch | count }} aus dem Buch, {{ eigene | count }} eigene
{%- if buch | count + eigene | count == 0 %} ⚠️ keine Farben{% endif %}
{%- if fehlt %} ⚠️ Buch-Nr. unbekannt oder als Licht ungeeignet: {{ fehlt | join(', ') }}{% endif %}
{%- if eigene | map('count') | select('lt', 2) | list %} ⚠️ eigene Palette mit weniger als 2 Farben{% endif %}
{%- if ohne_hell and 'standard' not in m.get('hell', {}) %} ⚠️ keine Helligkeit für: {{ ohne_hell | join(', ') }}{% endif %}
{%- if name.startswith(FAVORIT) %} ⚠️ Name darf nicht mit „★“ beginnen{% endif %}
{%- endfor %}
{%- endmacro -%}
